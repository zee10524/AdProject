<script>
// ✅ Generate a unique idempotency key for the booking form on page load
// Uses crypto.randomUUID() — available in all modern browsers
const idemKeyInput = document.getElementById('idempotencyKey');
if (idemKeyInput) {
    idemKeyInput.value = crypto.randomUUID();
}
</script>
<script>
// Interactive star rating
const stars  = document.querySelectorAll('.mk-star');
const rInput = document.getElementById('ratingInput');

stars.forEach(star => {
  star.addEventListener('mouseenter', () => {
    const val = +star.dataset.val;
    stars.forEach(s => s.classList.toggle('active', +s.dataset.val <= val));
  });

  star.addEventListener('click', () => {
    rInput.value = star.dataset.val;
    stars.forEach(s => {
      s.classList.toggle('active', +s.dataset.val <= +star.dataset.val);
      s.style.color = +s.dataset.val <= +star.dataset.val ? '#e8a840' : '#ddd';
    });
  });
});

document.getElementById('starRow')?.addEventListener('mouseleave', () => {
  const selected = rInput.value ? +rInput.value : 0;
  stars.forEach(s => {
    s.classList.toggle('active', +s.dataset.val <= selected);
    s.style.color = +s.dataset.val <= selected ? '#e8a840' : '#ddd';
  });
});
</script>
