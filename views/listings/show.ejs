<% layout('layouts/boilerplate') %>

<!-- Hero Banner -->
<div class="mk-hero mk-show-hero">
  <div class="mk-hero-overlay">
    <h1 class="mk-hero-title"><%= listing.title %></h1>
    <p class="mk-hero-breadcrumb">Home &nbsp;/&nbsp; Listings &nbsp;/&nbsp; Details</p>
  </div>
</div>

<section class="mk-show-section">

  <!-- ═══════════════════════════════════════════
       TOP PANEL: Image LEFT · Details RIGHT
  ════════════════════════════════════════════ -->
  <div class="mk-show-top">

    <!-- LEFT: Image -->
    <div class="mk-show-img-col">
      <div class="mk-show-img-wrap">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="mk-show-img" />
        <div class="mk-show-img-badge">
          <i class="fa-solid fa-star"></i>
          <%= listing.averageRating > 0 ? listing.averageRating.toFixed(1) : "New" %>
        </div>
      </div>
    </div>

    <!-- RIGHT: Details -->
    <div class="mk-show-info-col">

      <div class="mk-show-owner">
        <i class="fa-solid fa-circle-user"></i>
        Listed by <strong><%= listing.owner ? listing.owner.username : "Unknown" %></strong>
      </div>

      <h2 class="mk-show-title"><%= listing.title %></h2>

      <p class="mk-show-location">
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>

      <p class="mk-show-desc"><%= listing.description %></p>

      <div class="mk-show-divider"></div>

      <!-- Stats row -->
      <div class="mk-show-stats">
        <div class="mk-stat">
          <i class="fa-solid fa-indian-rupee-sign"></i>
          <div>
            <span class="mk-stat-val"><%= listing.price.toLocaleString('en-IN') %></span>
            <span class="mk-stat-label">per night</span>
          </div>
        </div>
        <div class="mk-stat">
          <i class="fa-solid fa-users"></i>
          <div>
            <span class="mk-stat-val"><%= listing.maxGuests %></span>
            <span class="mk-stat-label">Max Guests</span>
          </div>
        </div>
        <div class="mk-stat">
          <i class="fa-solid fa-door-open"></i>
          <div>
            <span class="mk-stat-val"><%= listing.roomsAvailable %></span>
            <span class="mk-stat-label">Rooms Available</span>
          </div>
        </div>
      </div>

      <div class="mk-show-divider"></div>

      <!-- Amenities -->
      <% if (listing.amenities && listing.amenities.length > 0) { %>
        <div class="mk-amenities">
          <p class="mk-amenities-title">Amenities</p>
          <div class="mk-amenities-list">
            <% listing.amenities.forEach(a => { %>
              <span class="mk-amenity-pill">
                <i class="fa-solid fa-circle-check"></i> <%= a %>
              </span>
            <% }) %>
          </div>
        </div>
        <div class="mk-show-divider"></div>
      <% } %>

      <!-- Owner controls -->
      <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
        <div class="mk-owner-controls">
          <a href="/listings/<%= listing._id %>/edit" class="mk-edit-btn">
            <i class="fa-solid fa-pen-to-square"></i> Edit Listing
          </a>
          <form method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                onsubmit="return confirm('Are you sure you want to delete this listing?');">
            <button class="mk-delete-btn" type="submit">
              <i class="fa-solid fa-trash"></i> Delete
            </button>
          </form>
        </div>
      <% } %>

    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       BOOKING + REVIEWS — Airbnb-style below
  ════════════════════════════════════════════ -->
  <div class="mk-show-bottom">

    <!-- LEFT: Booking Form -->
    <div class="mk-bottom-main">

      <div class="mk-section-block">
        <h3 class="mk-block-title">
          <i class="fa-regular fa-calendar-check"></i> Book This Stay
        </h3>

        <% if (currentUser) { %>
          <form action="/listings/<%= listing._id %>/bookings" method="POST" class="mk-booking-form">
            <input type="hidden" name="idempotencyKey" id="idempotencyKey" />
            <div class="mk-form-grid">
              <div class="mk-form-group">
                <label class="mk-label">Check In</label>
                <input type="date" name="checkIn" class="mk-input" required />
              </div>
              <div class="mk-form-group">
                <label class="mk-label">Check Out</label>
                <input type="date" name="checkOut" class="mk-input" required />
              </div>
              <div class="mk-form-group">
                <label class="mk-label">Guests</label>
                <input type="number" name="guests" class="mk-input" min="1" max="<%= listing.maxGuests %>" placeholder="1" required />
              </div>
              <div class="mk-form-group">
                <label class="mk-label">Guide</label>
                <select name="guide" class="mk-input" required>
                  <option value="">Select</option>
                  <option value="yes">Yes — Include Guide</option>
                  <option value="no">No Guide</option>
                </select>
              </div>
            </div>
            <button class="mk-confirm-btn" type="submit">
              <i class="fa-solid fa-bolt"></i> Confirm Booking
            </button>
          </form>
        <% } else { %>
          <div class="mk-login-prompt">
            <i class="fa-solid fa-lock"></i>
            Please <a href="/login">log in</a> to book this stay.
          </div>
        <% } %>
      </div>

      <div class="mk-show-divider"></div>

      <!-- Leave a Review -->
      <div class="mk-section-block">
        <h3 class="mk-block-title">
          <i class="fa-regular fa-star"></i> Leave a Review
        </h3>

        <% if (currentUser) { %>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" class="mk-review-form needs-validation" novalidate>
            <div class="mk-form-group">
              <label class="mk-label">Rating</label>
              <div class="mk-star-row" id="starRow">
                <% for(let s = 1; s <= 5; s++) { %>
                  <span class="mk-star" data-val="<%= s %>">★</span>
                <% } %>
              </div>
              <input type="hidden" name="review[rating]" id="ratingInput" required />
            </div>
            <div class="mk-form-group">
              <label class="mk-label">Comment</label>
              <textarea name="review[comment]" class="mk-input mk-textarea" rows="3" placeholder="Share your experience…" required></textarea>
            </div>
            <button class="mk-submit-review-btn" type="submit">
              Submit Review
            </button>
          </form>
        <% } else { %>
          <div class="mk-login-prompt">
            <i class="fa-solid fa-lock"></i>
            Please <a href="/login">log in</a> to leave a review.
          </div>
        <% } %>
      </div>

      <div class="mk-show-divider"></div>

      <!-- All Reviews -->
      <div class="mk-section-block">
        <h3 class="mk-block-title">
          <i class="fa-solid fa-comments"></i>
          Reviews
          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <span class="mk-review-count"><%= listing.reviews.length %></span>
          <% } %>
        </h3>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <div class="mk-reviews-list">
            <% listing.reviews.forEach((review) => { %>
              <div class="mk-review-card">
                <div class="mk-review-top">
                  <div class="mk-review-avatar">
                    <%= review.author ? review.author.username.charAt(0).toUpperCase() : "?" %>
                  </div>
                  <div>
                    <p class="mk-review-author"><%= review.author ? review.author.username : "Anonymous" %></p>
                    <div class="mk-review-stars">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <span class="<%= i <= review.rating ? 'mk-star-filled' : 'mk-star-empty' %>">★</span>
                      <% } %>
                    </div>
                  </div>
                </div>
                <p class="mk-review-comment"><%= review.comment %></p>
                <% if (currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
                  <form method="POST"
                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        onsubmit="return confirm('Delete this review?');">
                    <button class="mk-delete-review-btn" type="submit">
                      <i class="fa-solid fa-trash"></i> Delete
                    </button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="mk-no-reviews">No reviews yet — be the first to share your experience!</p>
        <% } %>
      </div>

    </div>
  </div>

  <!-- Back -->
  <div class="mk-back-row">
    <a href="/listings" class="mk-back-btn">
      <i class="fa-solid fa-arrow-left"></i> Back to Listings
    </a>
  </div>

</section>

