<% layout('layouts/boilerplate') %>

<!-- Hero Banner -->
<div class="mk-hero">
  <div class="mk-hero-overlay">
    <h1 class="mk-hero-title">Rooms &amp; Stays</h1>
    <p class="mk-hero-breadcrumb">Home &nbsp;/&nbsp; Listings</p>
  </div>
</div>

<!-- Listings Section -->
<section class="mk-listings-section">
  <div class="mk-section-header">
    <div class="mk-ornament">
      <svg class="mk-orn-svg" viewBox="0 0 260 28" xmlns="http://www.w3.org/2000/svg">
        <!-- Left decorative vine/flourish -->
        <path d="M2 14 C10 6, 22 6, 30 14 C38 22, 50 22, 58 14 C66 6, 75 8, 82 14 C88 18, 96 16, 102 14" 
              stroke="#b8955a" stroke-width="1.3" fill="none" stroke-linecap="round"/>
        <circle cx="20" cy="10" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="50" cy="18" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="78" cy="10" r="1.5" fill="#b8955a" opacity="0.6"/>
        <!-- Center diamond -->
        <polygon points="130,4 136,14 130,24 124,14" fill="#b8955a"/>
        <polygon points="130,8 134,14 130,20 126,14" fill="#fdf0d8"/>
        <!-- Small side diamonds -->
        <polygon points="118,10 122,14 118,18 114,14" fill="#b8955a" opacity="0.75"/>
        <polygon points="142,10 146,14 142,18 138,14" fill="#b8955a" opacity="0.75"/>
        <!-- Right decorative vine/flourish (mirrored) -->
        <path d="M158 14 C164 16, 172 18, 178 14 C184 10, 192 6, 200 14 C208 22, 218 22, 228 14 C236 6, 248 6, 258 14" 
              stroke="#b8955a" stroke-width="1.3" fill="none" stroke-linecap="round"/>
        <circle cx="172" cy="18" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="204" cy="10" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="236" cy="18" r="1.5" fill="#b8955a" opacity="0.6"/>
      </svg>
    </div>
    <h2 class="mk-section-title">Luxury Rooms &amp; Stays</h2>
  </div>

  <div class="mk-listings-grid">
    <% for(let i = 0; i < allListings.length; i++) {
       let listing = allListings[i];
       let isLuxury = (i < 3);
    %>
      <a href="/listings/<%= listing._id %>" class="mk-card-link">
        <div class="mk-card">
          <div class="mk-card-img-wrap">
            <% if (isLuxury) { %>
              <span class="mk-badge">Luxury Stay</span>
            <% } %>
            <img
              src="<%= listing.image.url %>"
              alt="<%= listing.title %>"
              class="mk-card-img"
              loading="lazy"
            />
          </div>
          <div class="mk-card-body">
            <div class="mk-card-top">
              <h3 class="mk-card-title"><%= listing.title %></h3>
              <div class="mk-card-rating">
                <i class="fa-solid fa-star"></i>
                <span><%= listing.averageRating > 0 ? listing.averageRating.toFixed(1) : "4.9" %></span>
                <i class="fa-solid fa-dove mk-dove"></i>
              </div>
            </div>
            <p class="mk-card-price">&#8377; <%= listing.price.toLocaleString('en-IN') %><span>/night</span></p>
            <div class="mk-card-meta">
              <span class="mk-meta-item">
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>
              </span>
              <span class="mk-meta-item">
                <i class="fa-solid fa-bed"></i>
                <%= listing.roomsAvailable %> Bed
              </span>
              <span class="mk-meta-item">
                <i class="fa-solid fa-shower"></i>
                1 Bath
              </span>
              <span class="mk-meta-item">
                <i class="fa-solid fa-tag"></i>
                &#8377; <%= listing.price.toLocaleString('en-IN') %>/mght
              </span>
            </div>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</section>
