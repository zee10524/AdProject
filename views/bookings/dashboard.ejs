<% layout('layouts/boilerplate') %>

<!-- Hero Banner -->
<div class="mk-hero mk-bookings-hero">
  <div class="mk-hero-overlay">
    <h1 class="mk-hero-title">My Bookings</h1>
    <p class="mk-hero-breadcrumb">Home &nbsp;/&nbsp; My Bookings</p>
  </div>
</div>

<!-- Bookings Section -->
<section class="mk-bookings-section">
  <div class="mk-section-header">
    <div class="mk-ornament">
      <svg class="mk-orn-svg" viewBox="0 0 260 28" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 14 C10 6, 22 6, 30 14 C38 22, 50 22, 58 14 C66 6, 75 8, 82 14 C88 18, 96 16, 102 14"
              stroke="#b8955a" stroke-width="1.3" fill="none" stroke-linecap="round"/>
        <circle cx="20" cy="10" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="50" cy="18" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="78" cy="10" r="1.5" fill="#b8955a" opacity="0.6"/>
        <polygon points="130,4 136,14 130,24 124,14" fill="#b8955a"/>
        <polygon points="130,8 134,14 130,20 126,14" fill="#fdf0d8"/>
        <polygon points="118,10 122,14 118,18 114,14" fill="#b8955a" opacity="0.75"/>
        <polygon points="142,10 146,14 142,18 138,14" fill="#b8955a" opacity="0.75"/>
        <path d="M158 14 C164 16, 172 18, 178 14 C184 10, 192 6, 200 14 C208 22, 218 22, 228 14 C236 6, 248 6, 258 14"
              stroke="#b8955a" stroke-width="1.3" fill="none" stroke-linecap="round"/>
        <circle cx="172" cy="18" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="204" cy="10" r="1.5" fill="#b8955a" opacity="0.6"/>
        <circle cx="236" cy="18" r="1.5" fill="#b8955a" opacity="0.6"/>
      </svg>
    </div>
    <h2 class="mk-section-title">Your Reserved Stays</h2>
  </div>

  <% if (bookings.length > 0) { %>

    <div class="mk-bookings-grid">
      <% bookings.forEach(booking => { %>

        <div class="mk-booking-card">

          <!-- Hotel Image -->
          <div class="mk-booking-img-wrap">
            <% if (booking.listing.image && booking.listing.image.url) { %>
              <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>" class="mk-booking-img" />
            <% } else { %>
              <div class="mk-booking-img-placeholder">
                <i class="fa-solid fa-hotel"></i>
              </div>
            <% } %>

            <!-- Status pill on image -->
            <span class="mk-status-pill mk-status-<%= booking.status %>">
              <% if (booking.status === 'confirmed') { %>
                <i class="fa-solid fa-circle-check"></i>
              <% } else { %>
                <i class="fa-solid fa-circle-xmark"></i>
              <% } %>
              <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
            </span>
          </div>

          <!-- Card Content -->
          <div class="mk-booking-body">

            <div class="mk-booking-title-row">
              <h3 class="mk-booking-title"><%= booking.listing.title %></h3>
              <p class="mk-booking-price">&#8377;<%= booking.totalPrice.toLocaleString('en-IN') %></p>
            </div>

            <p class="mk-booking-location">
              <i class="fa-solid fa-location-dot"></i>
              <%= booking.listing.location %>, <%= booking.listing.country %>
            </p>

            <div class="mk-booking-divider"></div>

            <div class="mk-booking-dates">
              <div class="mk-date-block">
                <span class="mk-date-label">Check-In</span>
                <span class="mk-date-value">
                  <i class="fa-regular fa-calendar-check"></i>
                  <%= booking.checkIn.toDateString() %>
                </span>
              </div>
              <div class="mk-date-sep">
                <i class="fa-solid fa-arrow-right-long"></i>
              </div>
              <div class="mk-date-block mk-date-block-right">
                <span class="mk-date-label">Check-Out</span>
                <span class="mk-date-value">
                  <i class="fa-regular fa-calendar-minus"></i>
                  <%= booking.checkOut.toDateString() %>
                </span>
              </div>
            </div>

            <div class="mk-booking-divider"></div>

            <div class="mk-booking-meta-row">
              <span class="mk-meta-pill">
                <i class="fa-solid fa-users"></i>
                <%= booking.guests %> Guest<%= booking.guests > 1 ? 's' : '' %>
              </span>
              <span class="mk-meta-pill">
                <i class="fa-solid fa-map"></i>
                Guide: <%= booking.guide ? 'Included' : 'None' %>
              </span>
            </div>

            <% if (booking.status === "confirmed") { %>
              <form method="POST"
                    action="/bookings/<%= booking._id %>?_method=DELETE"
                    onsubmit="return confirm('Are you sure you want to cancel this booking?');"
                    class="mk-cancel-form">
                <button class="mk-cancel-btn" type="submit">
                  <i class="fa-solid fa-xmark"></i>
                  Cancel Booking
                </button>
              </form>
            <% } %>

          </div>
        </div>

      <% }) %>
    </div>

  <% } else { %>

    <div class="mk-empty-state">
      <div class="mk-empty-icon">
        <i class="fa-solid fa-door-open"></i>
      </div>
      <h3 class="mk-empty-title">No Bookings Yet</h3>
      <p class="mk-empty-text">You haven't reserved any stays. Explore our luxury listings and find your perfect escape.</p>
      <a href="/listings" class="mk-explore-btn">
        <i class="fa-solid fa-compass"></i>
        Explore Listings
      </a>
    </div>

  <% } %>

</section>

<style>
/* ── Bookings Hero ── */
.mk-bookings-hero {
  background-image: url('https://images.unsplash.com/photo-1578683010236-d716f9a3f461?auto=format&fit=crop&w=1800&q=85') !important;
  background-position: center 55% !important;
}

/* ── Section ── */
.mk-bookings-section {
  background: #faf8f4;
  padding: 2.8rem 4vw 5rem;
  margin-left: calc(-50vw + 50%);
  width: 100vw;
}

/* ── Grid ── */
.mk-bookings-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem 1.8rem;
  max-width: 1100px;
  margin: 0 auto;
}

@media (max-width: 860px) {
  .mk-bookings-grid { grid-template-columns: 1fr; }
}

/* ── Booking Card ── */
.mk-booking-card {
  background: linear-gradient(145deg, #ffffff 0%, #f7f3ec 100%);
  border-radius: 16px;
  overflow: hidden;
  box-shadow:
    0 2px 8px rgba(0,0,0,0.06),
    0 8px 30px rgba(184,149,90,0.10),
    inset 0 0 0 1px rgba(184,149,90,0.15);
  transition: transform 0.24s ease, box-shadow 0.24s ease;
}

.mk-booking-card:hover {
  transform: translateY(-4px);
  box-shadow:
    0 6px 20px rgba(0,0,0,0.09),
    0 16px 40px rgba(184,149,90,0.18),
    inset 0 0 0 1px rgba(184,149,90,0.25);
}

/* ── Image ── */
.mk-booking-img-wrap {
  position: relative;
  height: 210px;
  overflow: hidden;
}

.mk-booking-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.35s ease;
}

.mk-booking-card:hover .mk-booking-img {
  transform: scale(1.04);
}

.mk-booking-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #2d5a3d 0%, #1a3326 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mk-booking-img-placeholder i {
  font-size: 3.5rem;
  color: rgba(184,149,90,0.6);
}

/* Status Pill */
.mk-status-pill {
  position: absolute;
  top: 13px;
  right: 13px;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 20px;
  letter-spacing: 0.4px;
  backdrop-filter: blur(6px);
}

.mk-status-confirmed {
  background: rgba(20, 80, 40, 0.88);
  color: #a8f0b8;
}

.mk-status-cancelled,
.mk-status-canceled {
  background: rgba(100, 20, 20, 0.88);
  color: #fca5a5;
}

/* ── Body ── */
.mk-booking-body {
  padding: 1.1rem 1.2rem 1.2rem;
}

.mk-booking-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.6rem;
  margin-bottom: 0.3rem;
}

.mk-booking-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0;
  line-height: 1.3;
}

.mk-booking-price {
  font-size: 1.05rem;
  font-weight: 700;
  color: #2d5a3d;
  margin: 0;
  white-space: nowrap;
}

.mk-booking-location {
  font-size: 0.8rem;
  color: #888;
  margin: 0 0 0.75rem;
  display: flex;
  align-items: center;
  gap: 5px;
}

.mk-booking-location i {
  color: #b8955a;
  font-size: 0.75rem;
}

/* Divider */
.mk-booking-divider {
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(184,149,90,0.3), transparent);
  margin: 0.75rem 0;
}

/* Dates */
.mk-booking-dates {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.1rem;
}

.mk-date-block {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

.mk-date-block-right {
  text-align: right;
}

.mk-date-label {
  font-size: 0.68rem;
  font-weight: 700;
  color: #b8955a;
  text-transform: uppercase;
  letter-spacing: 0.6px;
}

.mk-date-value {
  font-size: 0.78rem;
  color: #444;
  display: flex;
  align-items: center;
  gap: 5px;
}

.mk-date-block-right .mk-date-value {
  justify-content: flex-end;
}

.mk-date-value i {
  color: #2d5a3d;
  font-size: 0.7rem;
}

.mk-date-sep {
  color: #b8955a;
  font-size: 0.85rem;
  flex-shrink: 0;
  opacity: 0.7;
}

/* Meta pills */
.mk-booking-meta-row {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.mk-meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: rgba(45,90,61,0.08);
  color: #2d5a3d;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid rgba(45,90,61,0.15);
}

.mk-meta-pill i {
  font-size: 0.7rem;
}

/* Cancel button */
.mk-cancel-form {
  margin-top: 0.9rem;
}

.mk-cancel-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: 1.5px solid rgba(185, 50, 50, 0.5);
  color: #b93232;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 7px 16px;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.mk-cancel-btn:hover {
  background: #b93232;
  color: #fff;
  border-color: #b93232;
}

/* ── Empty State ── */
.mk-empty-state {
  text-align: center;
  padding: 5rem 2rem;
  max-width: 480px;
  margin: 0 auto;
}

.mk-empty-icon {
  width: 90px;
  height: 90px;
  background: linear-gradient(135deg, #2d5a3d, #1a3326);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  box-shadow: 0 8px 24px rgba(45,90,61,0.25);
}

.mk-empty-icon i {
  font-size: 2.2rem;
  color: #b8955a;
}

.mk-empty-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 0.6rem;
}

.mk-empty-text {
  color: #888;
  font-size: 0.9rem;
  line-height: 1.6;
  margin-bottom: 1.8rem;
}

.mk-explore-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #2d5a3d, #1a4a2e);
  color: #fff;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  padding: 12px 28px;
  border-radius: 30px;
  box-shadow: 0 4px 16px rgba(45,90,61,0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.mk-explore-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(45,90,61,0.4);
  color: #fff;
}
</style>
